<Window
    x:Class="MediaPlayer.WPF.Login"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:MediaPlayer.WPF"
    mc:Ignorable="d"
    Title="Login"
    Height="900"
    Width="1450"
    FontFamily="Consolas"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Blurred background image -->
        <Image
            Source="https://www.lifewire.com/thmb/TB06_60vJ1dzO5f2Uyc1YbO7ACQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/is-spotify-premium-worth-it-01-1541f7e533634227be75b715184dd793.jpg"
            Stretch="UniformToFill"
            OpacityMask="Black">
            <Image.Effect>
                <BlurEffect
                    Radius="15" />
            </Image.Effect>
        </Image>

        <!-- Dark transparent overlay -->
        <Rectangle
            Fill="#4C324173" />

        <!-- Foreground content -->
        <Grid
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Height="324"
            Width="300">
            <Border
                Background="#000000"
                Padding="25"
                CornerRadius="8">
                <StackPanel>
                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,30">
                        <Image
                            Source="/Assets/spotify.png"
                            Height="30"
                            Width="30">
                        </Image>
                        <TextBlock
                            Text="Spootify"
                            Foreground="White"
                            FontSize="24"
                            Margin="10,0,0,0"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center" />
                    </StackPanel>
                    
                    <TextBlock 
                        HorizontalAlignment="Center"
                        Text="Unlimited songs."
                        Foreground="#ffffff"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Margin="0,0,0,30"/>

                    <TextBlock 
                        Text="Email"
                        Foreground="#ffffff"/>
                    <TextBox
                        x:Name="EmailTextBox"
                        Width="200"
                        Margin="0,0,0,10" />
                    <PasswordBox
                        x:Name="PasswordTextBox"
                        Width="200"
                        Margin="0,0,0,10" />
                    <Button
                        x:Name="LoginButton"
                        Content="Login"
                        Width="200"
                        Height="50"
                        Click="LoginButton_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
