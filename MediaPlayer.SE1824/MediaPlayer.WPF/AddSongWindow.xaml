<Window
    x:Class="MediaPlayer.WPF.AddSongWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:MediaPlayer.WPF"
    mc:Ignorable="d"
    Title="AddSongWindow"
    Height="450"
    Width="800">
    <Grid>
        <Button
            x:Name="SelectSong"
            Content="Select Song"
            HorizontalAlignment="Center"
            Height="44"
            Margin="0,149,0,0"
            VerticalAlignment="Top"
            Width="152"
            Click="SelectSong_Click" />
        <Button
            x:Name="SelectCoverImage"
            Content="Select Cover Image"
            HorizontalAlignment="Center"
            Height="44"
            Margin="0,208,0,0"
            VerticalAlignment="Top"
            Width="222"
            Click="SelectCoverImage_Click" />

    </Grid>
</Window>
