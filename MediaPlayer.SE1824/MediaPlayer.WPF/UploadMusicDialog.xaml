<Window
    x:Class="MediaPlayer.WPF.UploadMusicDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:MediaPlayer.WPF"
    mc:Ignorable="d"
    Title="Add Song Details"
    Height="400"
    Width="500"
    Background="#121212"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize">
    <Grid
        Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock
            Grid.Row="0"
            Text="Add Song Details"
            Foreground="White"
            FontSize="24"
            FontWeight="Bold"
            Margin="0,0,0,30" />

        <!-- Form -->
        <StackPanel
            Grid.Row="1">
            <TextBlock
                Text="Song Title*"
                Style="{StaticResource LabelStyle}" />
            <TextBox
                x:Name="txtTitle"
                Style="{StaticResource TextBoxStyle}" />

            <TextBlock
                Text="Artist"
                Style="{StaticResource LabelStyle}" />
            <TextBox
                x:Name="txtArtist"
                Style="{StaticResource TextBoxStyle}" />

            <TextBlock
                Text="Album"
                Style="{StaticResource LabelStyle}" />
            <TextBox
                x:Name="txtAlbum"
                Style="{StaticResource TextBoxStyle}" />

            <TextBlock
                x:Name="txtFileName"
                Foreground="#B3B3B3"
                FontSize="12"
                TextWrapping="Wrap"
                Margin="0,10,0,0" />
        </StackPanel>

        <!-- Buttons -->
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,20,0,0">
            <Button
                Content="Cancel"
                Style="{StaticResource SpotifyButton}"
                Background="#404040"
                Click="BtnCancel_Click"
                Margin="0,0,10,0" />
            <Button
                Content="Upload"
                Style="{StaticResource SpotifyButton}"
                Click="BtnUpload_Click" />
        </StackPanel>
    </Grid>
</Window>
