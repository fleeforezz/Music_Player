<Window
    x:Class="MediaPlayer.WPF.Home"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:MediaPlayer.WPF"
    mc:Ignorable="d"
    Title="Spootify"
    Height="900"
    Width="1450"
    FontFamily="Segoe UI"
    WindowStartupLocation="CenterScreen"
    Background="#000000">

    <Window.Resources>
        <local:VolumeConverter
            x:Key="VolumeConverter" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                Width="240" />
            <ColumnDefinition
                Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar -->
        <Border
            Grid.Column="0"
            Background="#000000"
            Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="*" />
                    <RowDefinition
                        Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App Title -->
                <StackPanel
                    Grid.Row="0"
                    Margin="10,10,10,20">
                    <TextBlock
                        Text="Spootify"
                        Foreground="White"
                        FontSize="20"
                        FontWeight="Bold" />
                </StackPanel>

                <!-- Navigation Menu -->
                <StackPanel
                    Grid.Row="2">
                    <TextBlock
                        Text="My Library"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Margin="15,10,0,10"
                        FontSize="13" />

                    <Button
                        Content="Home"
                        Style="{StaticResource ModernButton}" />
                    <Button
                        Content="Tracks"
                        Style="{StaticResource ModernButton}" />
                    <Button
                        Content="Artists"
                        Style="{StaticResource ModernButton}" />
                    <Button
                        Content="Genres"
                        Style="{StaticResource ModernButton}" />

                    <Separator
                        Margin="10,15"
                        Background="#282828" />

                    <TextBlock
                        Text="Playlists"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Margin="15,10,0,10"
                        FontSize="13" />
                </StackPanel>

                <!-- Upload Button -->
                <Button
                    Grid.Row="3"
                    x:Name="btnUploadMusic"
                    Content="+ Upload Music"
                    Background="#1DB954"
                    Foreground="Black"
                    FontWeight="SemiBold"
                    Padding="15,10"
                    Margin="10"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="BtnUploadMusic_Click">
                    <Button.Template>
                        <ControlTemplate
                            TargetType="Button">
                            <Border
                                Background="{TemplateBinding Background}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid
            Grid.Column="1"
            Background="#121212">
            <Grid.RowDefinitions>
                <RowDefinition
                    Height="*" />
                <RowDefinition
                    Height="90" />
            </Grid.RowDefinitions>

            <!-- Scrollable Content -->
            <ScrollViewer
                Grid.Row="0"
                VerticalScrollBarVisibility="Auto">
                <StackPanel
                    Margin="30,20">

                    <!-- Hero Section -->
                    <Border
                        Height="280"
                        CornerRadius="8"
                        Margin="0,0,0,30">
                        <Border.Background>
                            <LinearGradientBrush
                                StartPoint="0,0"
                                EndPoint="1,0">
                                <GradientStop
                                    Color="#8B2828"
                                    Offset="0" />
                                <GradientStop
                                    Color="#2D5F4F"
                                    Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <StackPanel
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="40">
                                <Border
                                    Width="160"
                                    Height="160"
                                    CornerRadius="8"
                                    Background="#DC3545"
                                    Margin="0,0,30,0">
                                    <Image
                                        x:Name="imageHeroArt"
                                        Stretch="UniformToFill" />
                                </Border>
                                <StackPanel
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="txtHeroTitle"
                                        Text="Dancing With a Stranger (Single)"
                                        Foreground="White"
                                        FontSize="48"
                                        FontWeight="Bold"
                                        TextWrapping="Wrap"
                                        MaxWidth="600" />
                                    <TextBlock
                                        x:Name="txtHeroArtist"
                                        Text="Sam Smith, Normal"
                                        Foreground="#E0E0E0" />
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Margin="0,15,0,0">
                                        <Border
                                            Background="#333333"
                                            CornerRadius="4"
                                            Padding="8,4"
                                            Margin="0,0,10,0">
                                            <TextBlock
                                                Text="POP"
                                                Foreground="White"
                                                FontSize="12" />
                                        </Border>
                                        <Border
                                            Background="#333333"
                                            CornerRadius="4"
                                            Padding="8,4"
                                            Margin="0,0,10,0">
                                            <TextBlock
                                                Text="2019"
                                                Foreground="White"
                                                FontSize="12" />
                                        </Border>
                                    </StackPanel>
                                    <!-- <Button
                                        Content="▶"
                                        Style="{StaticResource PlayButton}"
                                        Margin="0,20,0,0"
                                        Click="BtnPlay_Click"/> -->
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Most Played Section -->
                    <Grid
                        Margin="0,0,0,30">
                        <Grid.RowDefinitions>
                            <RowDefinition
                                Height="Auto" />
                            <RowDefinition
                                Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="0,0,0,15">
                            <TextBlock
                                Text="Most Played"
                                Foreground="White"
                                FontSize="24"
                                FontWeight="Bold" />
                        </StackPanel>

                        <ScrollViewer
                            Grid.Row="1"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto">
                            <WrapPanel
                                x:Name="pnlMostPlayed"
                                Orientation="Horizontal">
                                <!-- Album cards will be added here programmatically -->
                            </WrapPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Explore Section -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition
                                Height="Auto" />
                            <RowDefinition
                                Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="0,0,0,15">
                            <TextBlock
                                Text="Explore from your librry"
                                Foreground="White"
                                FontSize="24"
                                FontWeight="Bold" />
                        </StackPanel>

                        <ListView
                            Grid.Row="1"
                            x:Name="lvSongs"
                            Background="Transparent"
                            BorderThickness="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            SelectionChanged="lvSongs_SelectionChanged">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel
                                        Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemContainerStyle>
                                <Style
                                    TargetType="ListViewItem">
                                    <Setter
                                        Property="Background"
                                        Value="Transparent" />
                                    <Setter
                                        Property="BorderThickness"
                                        Value="0" />
                                    <Setter
                                        Property="Padding"
                                        Value="0" />
                                    <Setter
                                        Property="Margin"
                                        Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Style="{StaticResource AlbumCard}"
                                        Width="170">
                                        <StackPanel>
                                            <Border
                                                Width="140"
                                                Height="140"
                                                CornerRadius="8"
                                                Background="#2563EB"
                                                Margin="0,0,0,10">
                                                <Image
                                                    Source="{Binding CoverArt}"
                                                    Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock
                                                Text="{Binding Title}"
                                                Foreground="White"
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"
                                                FontSize="14"
                                                Margin="0,0,0,5" />
                                            <TextBlock
                                                Text="{Binding Artist}"
                                                Foreground="#B3B3B3"
                                                FontSize="13"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Player Bar -->
            <Border
                Grid.Row="1"
                Background="#181818"
                BorderBrush="#282828"
                BorderThickness="0,1,0,0"
                Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="Auto" />
                        <ColumnDefinition
                            Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Now Playing Info -->
                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                        <Border
                            Width="56"
                            Height="56"
                            CornerRadius="4"
                            Background="#282828"
                            Margin="0,0,12,0">
                            <Image
                                x:Name="imgCoverArt"
                                Stretch="UniformToFill" />
                        </Border>
                        <StackPanel
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Name="txtNowPlaying"
                                Text="-"
                                Foreground="White"
                                FontSize="14"
                                FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="txtNowPlayingArtist"
                                Text="-"
                                Foreground="#B3B3B3"
                                FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <!-- PLayback Controls -->
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Width="500">
                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,8">
                            <Button
                                Content="🔀"
                                Style="{StaticResource ModernButton}"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Margin="5,0" />
                            <Button
                                Content="⏮"
                                Style="{StaticResource ModernButton}"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Margin="5,0"
                                HorizontalContentAlignment="Center" />
                            <Button
                                x:Name="btnPlay"
                                Content="▶"
                                Background="White"
                                Foreground="Black"
                                Width="36"
                                Height="36"
                                FontSize="12"
                                BorderThickness="0"
                                Margin="5,0"
                                Cursor="Hand"
                                Click="BtnPlay_Click">
                                <Button.Template>
                                    <ControlTemplate
                                        TargetType="Button">
                                        <Border
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="18">
                                            <ContentPresenter
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button
                                Content="⏭"
                                Style="{StaticResource ModernButton}"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Margin="5,0"
                                HorizontalContentAlignment="Center" />
                            <Button
                                Content="🔁"
                                Style="{StaticResource ModernButton}"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Margin="5,0"
                                HorizontalContentAlignment="Center" />
                        </StackPanel>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="Auto" />
                                <ColumnDefinition
                                    Width="*" />
                                <ColumnDefinition
                                    Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Text="0:00"
                                Foreground="#B3B3B3"
                                FontSize="11"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0" />

                            <ProgressBar
                                Grid.Column="1"
                                x:Name="progressBar"
                                Height="4"
                                Minimum="0"
                                Maximum="100"
                                Value="0"
                                Foreground="#1DB954"
                                Background="#4D4D4D"
                                BorderThickness="0"
                                MouseDown="progressBar_MouseDown" />

                            <TextBlock
                                Grid.Column="2"
                                Text="0:00"
                                Foreground="#B3B3B3"
                                FontSize="11"
                                VerticalAlignment="Center"
                                Margin="10,0,0,0" />
                        </Grid>
                    </StackPanel>
                    
                    <!-- Volume & Additional Controls -->
                    <StackPanel
                        Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                        <Button 
                            x:Name="btnStop"
                            Content="■"
                            Style="{StaticResource ModernButton}"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Margin="5,0"
                            HorizontalAlignment="Center"
                            Click="btnStop_Click" />
                        <Button
                            Content="🔊"
                            Style="{StaticResource ModernButton}"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Margin="5,0"
                            HorizontalContentAlignment="Center"/>
                        <Slider 
                            x:Name="sliderVolume"
                            Width="100"
                            Minimum="0"
                            Maximum="100"
                            Value="70"
                            VerticalAlignment="Center"
                            Foreground="#1DB954"
                            Margin="5,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        
        <!-- MediaElement for playing audio -->
        <MediaElement 
            x:Name="mediaPlayer"
            Grid.Column="1"
            LoadedBehavior="Manual"
            Volume="{Binding ElementName=sliderVolume, Path=Value, Converter={StaticResource VolumeConverter}}"
            Visibility="Collapsed"/>
    </Grid>
</Window>
